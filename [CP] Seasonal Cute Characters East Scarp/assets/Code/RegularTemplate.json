{
	"Changes": [
	
		// OUTFIT LOADS
	
		{
			"LogName": "Load NPC's Outfits",
			"Action": "Load",
			"Priority": "High",
			"Target": "Portraits/NPC_Spring, Portraits/NPC_Summer, Portraits/NPC_Fall, Portraits/NPC_Winter, Portraits/NPC_FlowerDance, Portraits/NPC_SpiritsEve, Portraits/NPC_Beach, Characters/NPC_Spring, Characters/NPC_Summer, Characters/NPC_Fall, Characters/NPC_Winter, Characters/NPC_FlowerDance, Characters/NPC_SpiritsEve, Characters/NPC_Beach",
			"FromFile": "assets/{{TargetPathOnly}}/NPC/{{TargetWithoutPath}}.png"
		},
		
		// NOSE OVERLAY
		{
			"LogName": "NPC - Seasonal Nose",
			"Action": "EditImage",
			"Target": "Characters/NPC_Spring, Characters/NPC_Summer, Characters/NPC_Fall, Characters/NPC_Winter, Characters/NPC_FlowerDance, Characters/NPC_SpiritsEve, Characters/NPC_Beach",
			"FromFile": "assets/{{TargetPathOnly}}/NPC/NPC_nose.png",
            "PatchMode": "Overlay",
			"When":
			{
				"NoNose": "false",
			},
		},
		
		//APPEARANCE DATA 
		{
			"LogName": "NPC Appearance Data",
			"Action": "EditData",
			"Target": "Data/Characters",
			"TargetField": ["NPC", "Appearance"],
			"Entries": {
				
				//Regular Outfits
				"{{ModId}}.NPCSpring": {
					"Id": "{{ModId}}.NPCSpring",
					"Condition": "SEASON spring",
					"Sprite": "Characters/NPC_Spring",
					"Portrait": "Portraits/NPC_Spring",
					"Precedence": -120,
				},

				"{{ModId}}.NPCSummer": {
					"Id": "{{ModId}}.NPCSummer",
					"Condition": "SEASON Summer",
					"Sprite": "Characters/NPC_Summer",
					"Portrait": "Portraits/NPC_Summer",
					"Precedence": -120,
				},
				
				"{{ModId}}.NPCFall": {
					"Id": "{{ModId}}.NPCFall",
					"Condition": "SEASON Fall",
					"Sprite": "Characters/NPC_Fall",
					"Portrait": "Portraits/NPC_Fall",
					"Precedence": -120,
				},
				
				"{{ModId}}.NPCWinter": {
					"Id": "{{ModId}}.NPCWinter",
					"Condition": "SEASON Winter",
					"Sprite": "Characters/NPC_Winter",
					"Portrait": "Portraits/NPC_Winter",
					"Precedence": -120,
				},
				
				//Festival Outfits
				
				"{{ModId}}.NPCFlowerDance": {
					"Id": "{{ModId}}.NPCFlowerDance",
					"Condition": "IS_EVENT festival_spring24, {{FestivalOutfits}}",
					"Sprite": "Characters/NPC_FlowerDance",
					"Portrait": "Portraits/NPC_FlowerDance",
					"Precedence": -1000,
				},
				
				"{{ModId}}.NPCSpirit": {
					"Id": "{{ModId}}.NPCSpirit",
					"Condition": "ANY \"IS_EVENT festival_fall27, {{FestivalOutfits}}\" \"SEASON Fall, DAY_OF_MONTH 27, LOCATION_NAME Target EastScarp_Village EastScarp_VillageInn, {{FestivalOutfits}}\"",
					"Sprite": "Characters/NPC_SpiritsEve",
					"Portrait": "Portraits/NPC_SpiritsEve",
					"Precedence": -1000,
				},
				
				//Beach
				
				"{{ModId}}.NPCBeach": {
					"Id": "{{ModId}}.NPCBeach",
					"Sprite": "Characters/NPC_Beach",
					"Portrait": "Portraits/NPC_Beach",
					"IsIslandAttire": true,
					"Precedence": -10000,
				},		
			},
		},
	]
}
